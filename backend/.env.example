# Copy this file to .env and edit it.  (.env is never committed: it holds secrets.)

# Development mode. Set to 0 on a real server.
DJANGO_DEBUG=1

# Long random string. Required when DJANGO_DEBUG=0. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# PostgreSQL connection:  postgres://USER:PASSWORD@HOST:PORT/DATABASE
# (Delete this line to use a throwaway SQLite file instead.)
DATABASE_URL=postgres://pips:pips@localhost:5432/pips_puzzles

# Hosts the server answers to. Add your laptop's Wi-Fi address so your phone can connect,
# e.g. localhost,127.0.0.1,192.168.1.5
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Only needed for the Expo web preview in a browser.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# --- Only on a server (see README, "Deploy the backend") ------------------------------------
# Supabase database: Connect > Session pooler, plus ?sslmode=require, e.g.
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
# Keep uploaded puzzle pictures in Supabase Storage (an S3-compatible bucket) instead of backend/media/:
# MEDIA_S3_BUCKET=puzzles
# MEDIA_S3_ENDPOINT=https://<ref>.storage.supabase.co/storage/v1/s3
# MEDIA_S3_REGION=ap-south-1
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=
# MEDIA_PUBLIC_HOST=<ref>.supabase.co/storage/v1/object/public/puzzles
