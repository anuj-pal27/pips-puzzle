# Copy this file to .env and edit it.  (.env is never committed: it holds secrets.)

# Development mode. Set to 0 on a real server.
DJANGO_DEBUG=1

# Long random string. Required when DJANGO_DEBUG=0. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# PostgreSQL connection:  postgres://USER:PASSWORD@HOST:PORT/DATABASE
# (Delete this line to use a throwaway SQLite file instead.)
DATABASE_URL=postgres://pips:pips@localhost:5432/pips_puzzles

# Hosts the server answers to. Add your laptop's Wi-Fi address so your phone can connect,
# e.g. localhost,127.0.0.1,192.168.1.5
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Only needed for the Expo web preview in a browser.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
